generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  idCard          String?         @unique
  firstName       String
  lastName        String
  email           String          @unique
  password        String
  phone           String?
  dateOfBirth     DateTime?
  role            String          @default("USER") // USER, LAWYER, ADMIN
  posts           Post[]
  comments        Comment[]
  postLikes       PostLike[]
  favorites       Favorite[]
  lawyerRequests  LawyerRequest[]
  consultations   Consultation[]
  messages        Message[]
  reviewsReceived Review[]        @relation("LawyerReviews")
  notifications   Notification[]
  createdAt       DateTime        @default(now())
  UserEbook       UserEbook[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Post {
  id          String     @id @default(uuid())
  title       String
  content     String
  isAnonymous Boolean    @default(false)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       PostLike[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PostLike {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Ebook {
  id          String      @id @default(uuid())
  title       String
  author      String?
  description String?
  coverUrl    String?
  fileUrl     String?
  fileSize    String?
  pageCount   Int?
  isFree      Boolean     @default(true)
  price       Float?
  categoryId  String?
  createdAt   DateTime    @default(now())
  Category    Category?   @relation(fields: [categoryId], references: [id])
  favorites   Favorite[]
  UserEbook   UserEbook[]
}

model Category {
  id          String  @id
  name        String
  description String?
  Ebook       Ebook[]
}

model UserEbook {
  id           String   @id
  userId       String
  ebookId      String
  lastPageRead Int?     @default(0)
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Ebook        Ebook    @relation(fields: [ebookId], references: [id])
  User         User     @relation(fields: [userId], references: [id])

  @@unique([userId, ebookId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ebookId   String
  ebook     Ebook    @relation(fields: [ebookId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, ebookId])
}

model LawyerRequest {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  subject        String?
  events         String?
  message        String?
  status         String        @default("AWAITING_REVIEW")
  consultationId String?       @unique
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  messages       Message[]
  createdAt      DateTime      @default(now())
}

model Message {
  id             String         @id @default(uuid())
  requestId      String?
  request        LawyerRequest? @relation(fields: [requestId], references: [id])
  consultationId String?
  consultation   Consultation?  @relation(fields: [consultationId], references: [id])
  senderId       String
  sender         User           @relation(fields: [senderId], references: [id])
  text           String
  createdAt      DateTime       @default(now())
  avatarUrl      String?
}

model Consultation {
  id            String         @id @default(uuid())
  userId        String
  lawyerId      String?
  subject       String
  status        String         @default("PENDING") // PENDING, ACTIVE, CLOSED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  messages      Message[]
  lawyerRequest LawyerRequest?
  review        Review?
}

model Review {
  id             String       @id @default(uuid())
  lawyerId       String
  lawyer         User         @relation("LawyerReviews", fields: [lawyerId], references: [id])
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  rating         Int
  comment        String
  createdAt      DateTime     @default(now())
}
